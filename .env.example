# Токен бота от @BotFather
BOT_TOKEN=
# Чат владельца — туда бот пересылает каждую присланную картинку
FLAGMANALEX_CHAT_ID=
# Своя учётка Mongo с readWrite только на базу IMAGE (не админская)
BD_TOKEN=mongodb://imagelinkbot:<пароль>@127.0.0.1:27017/IMAGE?replicaSet=rs0&authSource=admin
BD_NAME_IMAGE=IMAGE
# Начало ссылки на картинку: ${HOST}/image/<файл>.jpeg — nginx отдаёт её из ../image
HOST=https://api.wwms.ru/imagelinkbot
# Порт встроенного express (картинки отдаёт nginx, не он)
PORT=5050
# Адрес Bot API: пусто — api.telegram.org; с сервера в РФ — посредник tg-relay (как у warehouse)
TELEGRAM_API_URL=
